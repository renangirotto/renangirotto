---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import FormattedDate from "@/components/FormattedDate.astro";

import { ROUTES, SITE_DESCRIPTION } from "@/consts";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "pt-br" } }];
}

const { lang } = Astro.params;

const postsCollection = (
  await getCollection("blog", (post) => post.id.startsWith(`${lang}/`))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsList = postsCollection.map((post) => {
  const slug = post.id.slice(`${lang}/`.length);

  return {
    description: post.data.description,
    href: `${getRelativeLocaleUrl(lang, ROUTES.blog)}${slug}/`,
    id: post.id,
    pubDate: post.data.pubDate,
    title: post.data.title,
  };
});
---

<!doctype html>
<html lang={lang} class="is-theme-dark">
  <head>
    <BaseHead
      title="Blog Posts | Renan Girotto"
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header />
    <main>
      <ul class="container">
        {
          postsList.map((post) => (
            <li>
              <a href={post.href}>
                <p class="time">
                  <FormattedDate date={post.pubDate} />
                </p>
                <h3 class="title">{post.title}</h3>
                <p class="description">{post.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style>
  .description {
    font-size: 1.125rem;
  }

  .time {
    font-size: 0.875rem;
    &:not(:last-child) {
      margin-block-end: 4px;
    }
  }

  .title {
    position: relative;
    /* letter-spacing: 1.25px; */
    font-family: "Outfit Variable", sans-serif;
    font-size: 2.25rem;
    font-weight:;
    color: light-dark(var(--color-light-pink-100), var(--color-dark-pink-100));

    &:not(:last-child) {
      margin-block-end: 4px;
    }
  }

  ul {
    list-style: none;

    a {
      text-decoration: none;
    }

    li {
      &:not(:last-child) {
        margin-block-end: 64px;
      }

      &:where(:hover) {
        .title {
          text-decoration: underline;
        }
      }
    }
  }
</style>
