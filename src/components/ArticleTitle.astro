---
export interface Props {
  class?: string;
  tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

const { class: className, tag, ...rest } = Astro.props;

const CustomTag = tag || "h1";
---

<CustomTag class:list={["article-title", className]} {...rest}>
  <slot />
</CustomTag>

<style>
  .article-title {
    font-weight: 800;
    color: light-dark(var(--color-light-pink-100), var(--color-dark-pink-100));

    &:not(:last-child) {
      margin-block-end: var(--article-title-margin-block-end, 16px);

      &:has(+ p) {
        margin-block-end: var(--article-title-margin-block-end-p, 24px);
      }

      &:is(h2),
      &:is(h3) {
        margin-block: 56px 32px;
      }
    }
  }
</style>
