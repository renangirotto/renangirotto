---
import { ChevronDown } from "lucide-astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="accordion">
  <summary class="accordion-summary">
    <span>{title}</span>
    <ChevronDown />
  </summary>
  <div class="accordion-content">
    <slot name="text" />
    <slot />
  </div>
</details>

<style>
  .accordion {
    border-radius: 4px;
    border: 1px solid transparent;
    color: light-dark(
      var(--color-light-foreground-100),
      var(--color-dark-foreground-100)
    );
    background: light-dark(
      var(--color-light-background-200),
      var(--color-dark-selection-200)
    );

    &:not(:last-child) {
      margin-block-end: 32px;

      &:has(+ .accordion) {
        margin-block-end: 8px;
      }
    }

    &:hover,
    &:focus-within {
      border-color: light-dark(
        var(--color-light-comment-100),
        var(--color-dark-comment-200)
      );
    }

    &[open] .accordion-summary svg {
      transform: rotate(180deg);
    }
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px;
    padding-inline: 16px;
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    svg {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }
  }

  .accordion-content {
    --article-text-margin-block-end: 0px;

    background: light-dark(
      var(--color-light-background-300),
      var(--color-dark-selection-300)
    );

    & p {
      padding-block: 24px;
      padding-inline: 16px;
      font-size: 16px;
      font-weight: 500;
    }

    & pre {
      margin-block: 0px;
    }
  }
</style>
